'use client';
import { useEffect, useState } from 'react';
import { useI18n } from '@/lib/i18n';
import { useAuth } from '@/lib/store';
import { api } from '@/lib/api';
import { Input } from '@/components/ui/Input';
import {
  CheckCircleIcon, BanknotesIcon, UserCircleIcon, PhoneIcon,
} from '@heroicons/react/24/outline';

const T = {
  sw: {
    title: 'Mipangilio', subtitle: 'Mipangilio ya sherehe',
    general: 'Taarifa za Sherehe', contact: 'Mawasiliano', payment: 'Malipo',
    honoreeName: 'Jina la Mwenyeji',
    phonePrimary: 'Simu ya Kwanza', phoneSecondary: 'Simu ya Pili',
    whatsapp: 'WhatsApp', mixx: 'Namba ya Biashara ya Mixx',
    save: 'Hifadhi', saved: 'Imehifadhiwa!',
    note: 'Waalikwa watalipa kwa kutumia namba hii ya biashara kwenye Mixx by Yas.',
  },
  en: {
    title: 'Settings', subtitle: 'Celebration settings',
    general: 'Celebration Info', contact: 'Contact', payment: 'Payment',
    honoreeName: 'Host Name',
    phonePrimary: 'Primary Phone', phoneSecondary: 'Secondary Phone',
    whatsapp: 'WhatsApp', mixx: 'Mixx Business Number',
    save: 'Save', saved: 'Saved!',
    note: 'Guests will pay using this business number on Mixx by Yas.',
  },
};

export default function SettingsPage() {
  const { lang } = useI18n();
  const { tenant } = useAuth();
  const [form, setForm] = useState({
    honoreeName: '', phonePrimary: '', phoneSecondary: '',
    whatsappNumber: '', mixxBusinessNumber: '',
  });
  const [saving, setSaving] = useState(false);
  const [saved, setSaved] = useState(false);

  const text = T[lang];

  useEffect(() => {
    const slug = tenant?.slug || 'mama-dani';
    api.get(`/tenants/${slug}/config`).then((res) => {
      const t = res.data;
      setForm({
        honoreeName: t.honoreeName || '',
        phonePrimary: t.phonePrimary || '',
        phoneSecondary: t.phoneSecondary || '',
        whatsappNumber: t.whatsappNumber || '',
        mixxBusinessNumber: t.mixxBusinessNumber || '',
      });
    }).catch(console.error);
  }, [tenant?.slug]);

  async function save() {
    setSaving(true);
    try {
      await new Promise((r) => setTimeout(r, 400));
      setSaved(true);
      setTimeout(() => setSaved(false), 2000);
    } finally { setSaving(false); }
  }

  return (
    <div className="space-y-5 max-w-2xl">
      <div>
        <h1 className="font-display text-2xl sm:text-3xl lg:text-4xl text-white">{text.title}</h1>
        <p className="text-text-secondary mt-1 text-xs sm:text-sm">{text.subtitle}</p>
      </div>

      <div className="card p-4 sm:p-5 space-y-4">
        <div className="flex items-center gap-2 pb-3 border-b border-border-subtle">
          <UserCircleIcon className="h-4 w-4 text-brand" />
          <h2 className="font-display text-base sm:text-lg text-white">{text.general}</h2>
        </div>
        <Input label={text.honoreeName} value={form.honoreeName}
          onChange={(e) => setForm({ ...form, honoreeName: e.target.value })} />
      </div>

      <div className="card p-4 sm:p-5 space-y-4">
        <div className="flex items-center gap-2 pb-3 border-b border-border-subtle">
          <PhoneIcon className="h-4 w-4 text-brand" />
          <h2 className="font-display text-base sm:text-lg text-white">{text.contact}</h2>
        </div>
        <Input label={text.phonePrimary} value={form.phonePrimary}
          onChange={(e) => setForm({ ...form, phonePrimary: e.target.value })} inputMode="tel" />
        <Input label={text.phoneSecondary} value={form.phoneSecondary}
          onChange={(e) => setForm({ ...form, phoneSecondary: e.target.value })} inputMode="tel" />
        <Input label={text.whatsapp} value={form.whatsappNumber}
          onChange={(e) => setForm({ ...form, whatsappNumber: e.target.value })} inputMode="tel" />
      </div>

      <div className="card p-4 sm:p-5 space-y-4">
        <div className="flex items-center gap-2 pb-3 border-b border-border-subtle">
          <BanknotesIcon className="h-4 w-4 text-brand" />
          <h2 className="font-display text-base sm:text-lg text-white">{text.payment}</h2>
        </div>
        <Input label={text.mixx} value={form.mixxBusinessNumber}
          onChange={(e) => setForm({ ...form, mixxBusinessNumber: e.target.value })} className="font-mono" />
        <div className="p-3 rounded-xl bg-bg-surface text-[11px] sm:text-xs text-text-muted">
          {text.note}
        </div>
      </div>

      <div className="flex items-center gap-3">
        <button
          onClick={save}
          disabled={saving}
          className="h-11 px-6 rounded-xl bg-brand text-text-primary font-semibold text-sm
                     hover:bg-brand-dark disabled:opacity-50 transition
                     flex items-center justify-center gap-2"
        >
          {saving
            ? <span className="h-4 w-4 border-2 border-white/40 border-t-white rounded-full animate-spin" />
            : text.save}
        </button>
        {saved && (
          <span className="inline-flex items-center gap-1.5 text-sm text-emerald-400">
            <CheckCircleIcon className="h-4 w-4" />
            {text.saved}
          </span>
        )}
      </div>
    </div>
  );
}
